module

public import Mathlib.AlgebraicGeometry.EllipticCurve.Affine.Point
public import Mathlib.GroupTheory.OrderOfElement

/-!
# ECDLP: exact problem statement and elementary structural lemmas

Ledger: research/ecdlp (PI RUN-62dbda7c-fe4f-4432-84a2-2068cd516355, task ECDLP-1).

This module fixes the *mathematical* input/output relation of the discrete
logarithm problem in an arbitrary additive commutative group and specializes it
to Mathlib's affine Weierstrass points `W.Point`. It says nothing about
encodings, algorithms or bit complexity; those are separate obligations.

None of the lemmas below is a new research result. They are reusable
foundations and correctness statements for transformations.
-/

@[expose] public section

namespace MathResearch.ECDLP

variable {G H : Type*} [AddCommGroup G] [AddCommGroup H]

/-- A discrete-logarithm instance: a base point and a target point. -/
structure Instance (G : Type*) [AddCommGroup G] where
  base : G
  target : G

/-- `k` solves the instance when `k • base = target`. -/
def IsSolution (I : Instance G) (k : ℕ) : Prop := k • I.base = I.target

/-- The promise of the search problem: the target lies in the cyclic monoid generated by
the base. -/
def Promise (I : Instance G) : Prop := ∃ k : ℕ, IsSolution I k

/-- Solutions are exactly one residue class modulo the order of the base. -/
theorem isSolution_iff_modEq {I : Instance G} {k l : ℕ} (hk : IsSolution I k) :
    IsSolution I l ↔ l ≡ k [MOD addOrderOf I.base] := by
  unfold IsSolution at *
  rw [← hk]
  exact nsmul_eq_nsmul_iff_modEq

/-- Under the promise, and when the base has finite (positive) order, there is a unique
canonical solution below the order. -/
theorem existsUnique_canonical_solution {I : Instance G} (h : Promise I)
    (hpos : 0 < addOrderOf I.base) :
    ∃! k : ℕ, k < addOrderOf I.base ∧ IsSolution I k := by
  obtain ⟨k, hk⟩ := h
  refine ⟨k % addOrderOf I.base, ⟨Nat.mod_lt _ hpos, ?_⟩, ?_⟩
  · exact (isSolution_iff_modEq hk).2 (Nat.mod_modEq _ _)
  · rintro l ⟨hl, hsol⟩
    have h1 : l ≡ k [MOD addOrderOf I.base] := (isSolution_iff_modEq hk).1 hsol
    have h2 : l % addOrderOf I.base = k % addOrderOf I.base := h1
    rwa [Nat.mod_eq_of_lt hl] at h2

/-- Transport of an instance along an additive group homomorphism. -/
def Instance.map (φ : G →+ H) (I : Instance G) : Instance H := ⟨φ I.base, φ I.target⟩

/-- Soundness of homomorphic transfer: every solution survives the transfer. -/
theorem IsSolution.map (φ : G →+ H) {I : Instance G} {k : ℕ} (hk : IsSolution I k) :
    IsSolution (I.map φ) k := by
  unfold IsSolution Instance.map at *
  rw [← map_nsmul, hk]

/-- Information content of homomorphic transfer: a solution `l` of the transferred instance
determines the original logarithm only modulo the order of the image of the base. -/
theorem modEq_of_map_solution (φ : G →+ H) {I : Instance G} {k l : ℕ} (hk : IsSolution I k)
    (hl : IsSolution (I.map φ) l) : l ≡ k [MOD addOrderOf (φ I.base)] :=
  (isSolution_iff_modEq (I := I.map φ) (hk.map φ)).1 hl

/-- The modulus obtained from a transfer always divides the original order. -/
theorem addOrderOf_map_base_dvd (φ : G →+ H) (I : Instance G) :
    addOrderOf (φ I.base) ∣ addOrderOf I.base :=
  addOrderOf_map_dvd φ I.base

/-- Negating both points preserves every solution. -/
theorem IsSolution.neg {I : Instance G} {k : ℕ} (hk : IsSolution I k) :
    IsSolution ⟨-I.base, -I.target⟩ k := by
  unfold IsSolution at *
  simp [hk]

/-- Elliptic-curve specialization: an ECDLP instance on the affine points (with the point at
infinity) of a Weierstrass curve over a field. -/
abbrev ECInstance {F : Type*} [Field F] [DecidableEq F] (W : WeierstrassCurve.Affine F) := Instance W.Point

end MathResearch.ECDLP

end
